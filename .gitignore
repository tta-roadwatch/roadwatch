# ── 빌드 산출물 ──────────────────────────────
node_modules/
dist/
build/
.vite/

# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── 환경 (.env.example 만 커밋한다) ───────────
.env
.env.local
.env.*.local

# ── 원본 데이터 (685MB · GitHub 100MB 제한 초과) ──
# 제출 zip 에는 .pkgignore 규칙에 따라 포함된다
data/raw/*
!data/raw/.gitkeep

# ── 에디터 · OS ─────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── 도구 ────────────────────────────────────
.claude/
*.log

# ── 배포 산출물 ──────────────────────────────
*.zip
