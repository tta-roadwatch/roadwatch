# ── Database ──────────────────────────────────
POSTGRES_USER=roadwatch
POSTGRES_PASSWORD=roadwatch
POSTGRES_DB=roadwatch
# 호스트에 노출할 포트 (컨테이너 내부는 항상 5432)
DB_HOST_PORT=15432
DATABASE_URL=postgresql://roadwatch:roadwatch@db:5432/roadwatch
# 컨테이너 밖(로컬 파이썬)에서 붙을 때
# DATABASE_URL=postgresql://roadwatch:roadwatch@localhost:15432/roadwatch

# ── VWorld 지도 타일 ───────────────────────────
# https://www.vworld.kr 에서 발급 (없어도 분석 레이어는 동작)
VITE_VWORLD_KEY=

# ── 생성형 AI 점검 리포트 ──────────────────────
# 비워두면 규칙 기반 템플릿으로 자동 대체된다 (화면은 정상 동작)
ANTHROPIC_API_KEY=

# ── API ───────────────────────────────────────
VITE_API_BASE=http://localhost:8000
