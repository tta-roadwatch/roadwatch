# ── Database ──────────────────────────────────
POSTGRES_USER=roadwatch
POSTGRES_PASSWORD=roadwatch
POSTGRES_DB=roadwatch
# 호스트에 노출할 포트 (컨테이너 내부는 항상 5432)
DB_HOST_PORT=15432
DATABASE_URL=postgresql://roadwatch:roadwatch@db:5432/roadwatch
# 컨테이너 밖(로컬 파이썬)에서 붙을 때
# DATABASE_URL=postgresql://roadwatch:roadwatch@localhost:15432/roadwatch

# ── VWorld 지도 타일 ───────────────────────────
# https://www.vworld.kr 에서 발급 (없어도 분석 레이어는 동작)
VITE_VWORLD_KEY=

# ── 인증 ──────────────────────────────────────
# 토큰 서명 키. 비워두면 개발용 기본값을 쓰며 /api/auth/config 가 그 사실을
# 알려준다. 배포 시 반드시 32바이트 이상의 임의 문자열로 바꾼다.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 데모 계정 : demo / roadwatch2026  (화면의 '테스트 로그인' 버튼)
#            admin / roadwatch2026!

# ── 생성형 AI 점검 리포트 ──────────────────────
# 비워두면 규칙 기반 템플릿으로 자동 대체된다 (화면은 정상 동작)
ANTHROPIC_API_KEY=

# ── CORS ──────────────────────────────────────
# 브라우저에서 이 API 를 부를 수 있는 출처. 쉼표로 나눈다.
# 화면을 다른 포트나 호스트로 띄우면 여기에 더한다.
#   예) CORS_ORIGINS=http://localhost:5173,http://192.168.0.10:5173
# "*" 로 두면 전부 열린다 — 재현이 막힐 때 쓰되, 그 상태는
# GET /api/auth/config 의 cors_open_to_all 이 알려준다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── API ───────────────────────────────────────
VITE_API_BASE=http://localhost:8000
